# Every variable compose.yaml reads. All have working defaults, so
# `docker compose up` runs without copying this file at all — copy it to .env
# only when you want to change something.
#
#   cp .env.example .env

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=ethara
POSTGRES_PASSWORD=ethara
POSTGRES_DB=ethara

# --- Host ports -------------------------------------------------------------
# Only these are published. Change them if something already owns the port.
API_HOST_PORT=8000
WEB_HOST_PORT=3000
# 5433 by default so a Postgres already running on 5432 is left alone.
POSTGRES_HOST_PORT=5433

# --- API --------------------------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS_RAW=http://localhost:3000

# Optional. Blank runs the assistant on its deterministic engine only, which is
# a fully working demo - the Groq layer is an upgrade, not a requirement.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Root level for the JSON logger. DEBUG adds SQLAlchemy and httpx internals.
LOG_LEVEL=INFO

# Per-IP cap on POST /ai/query — the only route that spends money.
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend ---------------------------------------------------------------
# Inlined into the browser bundle at BUILD time, so it must be reachable from
# your browser, not from inside the compose network. Changing it requires
# `docker compose build frontend`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
