# Database — local dev uses SQLite by default; set Postgres URL in prod (Render).
DATABASE_URL=sqlite:///./ethara.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ethara

# CORS — comma-separated frontend origins allowed to call the API.
CORS_ORIGINS_RAW=http://localhost:3000

# Groq (AI assistant) — get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Root level for the JSON logger. DEBUG adds SQLAlchemy and httpx internals.
LOG_LEVEL=INFO

# Per-IP cap on POST /ai/query — the only route that spends money.
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
